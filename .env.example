# DeepSeek API — get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat (cheap, function calling) or deepseek-reasoner (deeper reasoning)
SYLITHE_MODEL=deepseek-chat

# Storage (Postgres in production: postgresql+psycopg://user:pass@host/sylithe)
DATABASE_URL=sqlite:///./sylithe.db
AUDIT_LOG_PATH=./audit.log.jsonl

# GitHub webhook (Settings -> Webhooks -> Secret)
GITHUB_WEBHOOK_SECRET=

# Directory the agent's skills are allowed to operate on
WORKSPACE_ROOT=.

MAX_AGENT_ITERATIONS=20
